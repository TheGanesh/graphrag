# Copy to .env and fill in.  The chapter scripts load it automatically.

# --- ArangoDB (matches docker-compose.yml) ---
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=openSesame

# --- LLM: any OpenAI-compatible endpoint ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
LLM_MODEL=gpt-5.4-mini                        # any chat model your provider offers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                            # must match the embedding model
# LLM_TEMPERATURE=0                           # only if your model accepts it

# Offline mode for the plumbing (no API key needed): fake hashing-trick vectors
# EMBEDDINGS=hash
